# ── MongoDB ──────────────────────────────────────────────────────────
MONGO_USER=reel
MONGO_PASS=changeme
MONGO_URI=mongodb://reel:changeme@localhost:27017/reeldb?authSource=admin

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Gateway ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_change_me
UPLOADS_DIR=./uploads
OUTPUTS_DIR=./outputs

# Storage (local for dev; swap to S3/R2 for prod)
STORAGE_TYPE=local        # local | s3 | r2
S3_BUCKET=reel-videos
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=

# ── Razorpay ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── AI Service ───────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
UPLOADS_DIR=/app/uploads
OUTPUTS_DIR=/app/outputs

# Whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# CLIP model (open-source)
CLIP_MODEL=ViT-B/32

# ── Frontend (Next.js public vars) ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_xxxxxx

# ── Export pricing ────────────────────────────────────────────────────
EXPORT_PRICE_INR=2000        # in paise (₹20 = 2000 paise)
WATERMARK_TEXT=@AIReelEditor
